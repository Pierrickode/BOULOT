[Unit]
Description=AppliGPS i.MX8 OpenStreetMap Navigation System
After=weston.service
Wants=weston.service

[Service]
Type=simple
Environment="QT_QPA_PLATFORM=wayland"
Environment="XDG_RUNTIME_DIR=/run/user/0"
ExecStart=/usr/bin/AppliGPS
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
